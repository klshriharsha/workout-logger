# Used by the app (lib/config.ts) and `pnpm set-password`.
# Copy this to .env.local and fill in real values for local development.

# Postgres connection string. For the local Supabase stack (`pnpm exec supabase start`):
#   DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For a hosted Supabase project: Dashboard → Connect → Transaction pooler (port 6543), with the
# database password filled in and `?sslmode=require` appended (hosted Supabase rejects connections
# without SSL). Keep it secret: it bypasses Row Level Security.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require

# Optional. Defaults to info.
# LOG_LEVEL=info
