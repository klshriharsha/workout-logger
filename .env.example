# Used by the app/api/* Route Handlers and proxy.ts (lib/config.ts).
# Copy this to .env.local and fill in real values for local development.

# For a local Supabase stack (`pnpm exec supabase start`), set:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# (the CLI's built-in default local key, also listed by `pnpm exec supabase status`).
# Migration tooling is configured separately — see supabase/README.md.
SUPABASE_URL=https://your-project.supabase.co
# Dashboard → Settings → API Keys → Publishable key. Safe to expose; Row Level Security does the guarding.
SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key

# Optional. Defaults to info.
# LOG_LEVEL=info
