# Used by the app/api/* Route Handlers (lib/config.ts).
# Copy this to .env.local and fill in real values for local development.

# For a local Supabase stack (`pnpm exec supabase start`), set:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# (the CLI's built-in default local key; `[auth]` is disabled in supabase/config.toml so
#  `supabase status` does not print it). Migration tooling is configured separately — see supabase/README.md.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Optional. Defaults to info.
# LOG_LEVEL=info
